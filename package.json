{
  "name": "type-color",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && rm -f type-color-*.zip && cd dist && zip -r \"../type-color-$npm_package_version.zip\" ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.42",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
